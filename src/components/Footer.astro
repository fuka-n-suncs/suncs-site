---
import { FOOTER_NAV, LEGAL_NAV, SITE_TITLE } from '../consts';

const year = 2026;
---

<footer class="footer">
  <div class="footer__inner container--wide">
    <div class="footer__brand">
      <img
        class="footer__logo"
        src="/logo-horizontal-white.svg"
        alt={SITE_TITLE}
        width="177"
        height="50"
      />
      <address class="footer__address">
        〒141-0033 東京都品川区西品川1-2-1 大崎ガーデンレジデンス<br />
        <a href="mailto:info@sun-cs.co.jp">info@sun-cs.co.jp</a><br />
        070-8442-7245（平日 9:00〜19:00）
      </address>
    </div>

    <nav class="footer__nav" aria-label="フッターナビゲーション">
      {
        FOOTER_NAV.map((group) => (
          <div class="footer__group">
            <h2 class="footer__heading">{group.heading}</h2>
            <ul class="footer__list">
              {group.items.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="footer__bottom container--wide">
    <ul class="footer__legal">
      {LEGAL_NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
    <p class="footer__copyright">&copy; {year} {SITE_TITLE}, inc.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-section);
    padding-block: var(--space-16) var(--space-6);
    color: var(--color-text-inverse);
    background: var(--color-surface-inverse);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-12);
    margin-inline: auto;
    padding-inline: var(--container-gutter);
  }

  .footer__logo {
    width: auto;
    height: 40px;
  }

  .footer__address {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-style: normal;
    line-height: var(--leading-normal);
    color: rgb(255 255 255 / 0.78);
  }

  .footer__nav {
    display: grid;
    gap: var(--space-8);
  }

  .footer__heading {
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    color: rgb(255 255 255 / 0.6);
  }

  .footer__list {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .footer a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target-min);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--color-text-inverse);
    text-decoration: underline;
  }

  .footer__bottom {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-16) auto 0;
    padding-top: var(--space-6);
    padding-inline: var(--container-gutter);
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.7);
  }

  .footer__copyright {
    font-size: var(--text-xs);
    color: rgb(255 255 255 / 0.6);
  }

  @media (min-width: 768px) {
    .footer__inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-16);
    }

    .footer__nav {
      grid-auto-flow: column;
      gap: var(--space-16);
    }

    .footer__group {
      align-content: start;
    }

    .footer a {
      min-height: 0;
    }

    .footer__list {
      gap: var(--space-3);
    }

    .footer__bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
