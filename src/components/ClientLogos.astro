---
import { Image } from 'astro:assets';
import { CLIENTS } from '../consts';

/**
 * 導入企業ロゴ。1行の帯にして右から左へ無限に流す。
 *
 * 同じ並びを2組出力し、トラック全体を -50%（＝1組分）動かして先頭に戻す。
 * 継ぎ目なくループするのはこのため。組数を変えると破綻するので2組固定。
 *
 * 元画像は白背景・高さ96pxに正規化済み（表示は32pxなので3倍。粗さは出ない）。
 */
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/clients/*.{svg,png,webp,jpg,jpeg}', {
  eager: true,
});

const items = CLIENTS.map((client) => ({
  ...client,
  image: client.file ? logos[`../assets/clients/${client.file}`]?.default : undefined,
})).filter((item) => item.image);

/* 1周の秒数。社数に比例させて、増えても流れる速さが変わらないようにする */
const duration = items.length * 4.5;
---

<div class="marquee" style={`--marquee-duration:${duration}s`}>
  <div class="marquee__track">
    {
      [0, 1].map((copy) => (
        <ul class="marquee__group" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((item) => (
            <li class="marquee__item">
              {item.url ? (
                <a href={item.url} target="_blank" rel="noopener" aria-label={`${item.name}（外部サイト）`}>
                  <Image src={item.image!} alt={item.name} height={32} densities={[1, 2, 3]} loading="lazy" />
                </a>
              ) : (
                <Image src={item.image!} alt={item.name} height={32} densities={[1, 2, 3]} loading="lazy" />
              )}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    /* 両端をなだらかに消して、切れ端が見えないようにする */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee var(--marquee-duration) linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__group {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-inline-end: clamp(2rem, 4vw, 3.5rem);
  }

  .marquee__item :global(img) {
    height: 32px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    /* 白背景の画像なので、帯の白地に溶け込む */
    mix-blend-mode: multiply;
  }

  .marquee__item a {
    display: block;
    transition: opacity var(--duration-fast) var(--easing-standard);
  }

  .marquee__item a:hover {
    opacity: 0.6;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* 動きを減らす設定では停止し、横スクロールで見られるようにする */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .marquee__track {
      animation: none;
    }
  }
</style>
