---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { MEDIA_CATEGORY_LABEL, MEDIA_TYPE_LABEL } from '../consts';
import IconInterview from './icons/IconInterview.astro';
import IconBlueprint from './icons/IconBlueprint.astro';
import IconCycle from './icons/IconCycle.astro';
import IconGlobe from './icons/IconGlobe.astro';

interface Props {
  entry: CollectionEntry<'media'>;
}

const { entry } = Astro.props;
const { title, summary, date, category, type, eyecatch, eyecatchAlt } = entry.data;

/** カテゴリを一目で見分けられるようにするアイコン */
const MEDIA_CATEGORY_ICON = {
  interview: IconInterview,
  'cs-design': IconBlueprint,
  'cs-ops': IconCycle,
  global: IconGlobe,
} as const;
const CategoryIcon = MEDIA_CATEGORY_ICON[category];

const formatDate = (value: Date) =>
  new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium', timeZone: 'Asia/Tokyo' }).format(value);
---

<article class="card">
  {
    eyecatch && (
      <div class="card__thumb">
        <Image src={eyecatch} alt={eyecatchAlt ?? ''} width={640} loading="lazy" />
      </div>
    )
  }

  <p class="card__meta">
    <span class:list={['card__type', `card__type--${type}`]}>{MEDIA_TYPE_LABEL[type]}</span>
    <span class="card__category">
      <span class="card__category-icon" aria-hidden="true">
        <CategoryIcon />
      </span>
      {MEDIA_CATEGORY_LABEL[category]}
    </span>
  </p>

  <h3 class="card__title">
    <a href={`/media/${entry.id}`}>{title}</a>
  </h3>

  <p class="card__summary">{summary}</p>

  <time class="card__date tabular" datetime={date.toISOString()}>{formatDate(date)}</time>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-6);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      box-shadow var(--duration-base) var(--easing-standard),
      transform var(--duration-base) var(--easing-standard);
  }

  .card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  /* カードの角丸に合わせて上端いっぱいまで画像を出す */
  .card__thumb {
    margin: calc(var(--space-6) * -1) calc(var(--space-6) * -1) var(--space-2);
    aspect-ratio: 1200 / 630;
    background: var(--color-surface-muted);
  }

  .card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
  }

  .card__type {
    padding: 2px var(--space-3);
    border-radius: var(--radius-full);
    font-weight: var(--weight-bold);
  }

  .card__type--article {
    background: var(--color-primary-subtle);
    color: var(--color-primary);
  }

  .card__type--material {
    background: var(--color-accent-subtle);
    color: var(--color-accent-strong);
  }

  .card__category {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
  }

  .card__category-icon {
    display: inline-flex;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  .card__category-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .card__title {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .card__title a {
    text-decoration: none;
  }

  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__summary {
    flex-grow: 1;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .card__date {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
