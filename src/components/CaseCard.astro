---
import type { CollectionEntry } from 'astro:content';
import { SERVICE_LABEL } from '../consts';

interface Props {
  entry: CollectionEntry<'cases'>;
}

const { entry } = Astro.props;
const { title, summary, industry, companySize, supportPeriod, service, metrics } = entry.data;
---

<article class="case">
  <p class="case__service">{SERVICE_LABEL[service]}</p>

  <h3 class="case__title">
    <a href={`/cases/${entry.id}`}>{title}</a>
  </h3>

  {
    metrics && metrics.length > 0 && (
      <p class="case__metric tabular">
        <span class="case__metric-label">{metrics[0].label}</span>
        <span class="case__metric-value">{metrics[0].value}</span>
      </p>
    )
  }

  <p class="case__summary">{summary}</p>

  <dl class="case__meta">
    <dt>事業内容</dt>
    <dd>{industry}</dd>
    <dt>会社規模</dt>
    <dd>{companySize}</dd>
    <dt>支援期間</dt>
    <dd>{supportPeriod}</dd>
  </dl>
</article>

<style>
  .case {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: box-shadow var(--duration-base) var(--easing-standard);
  }

  .case:hover {
    box-shadow: var(--shadow-md);
  }

  .case__service {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-primary);
  }

  .case__title {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .case__title a {
    text-decoration: none;
  }

  /* カード全体をクリック領域にする */
  .case__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .case {
    position: relative;
  }

  .case__metric {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--color-primary-subtle);
    border-radius: var(--radius-md);
  }

  .case__metric-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .case__metric-value {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    color: var(--color-primary);
  }

  .case__summary {
    flex-grow: 1;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .case__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
  }

  .case__meta dt {
    color: var(--color-text-muted);
  }
</style>
