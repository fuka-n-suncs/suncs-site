---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { NEWS_CATEGORY_LABEL } from '../consts';

interface Props {
  items: CollectionEntry<'news'>[];
}

const { items } = Astro.props;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('ja-JP', { dateStyle: 'long', timeZone: 'Asia/Tokyo' }).format(date);
---

<ul class="news" data-reveal-stagger>
  {
    items.map((item) => {
      const href = item.data.externalUrl ?? `/news/${item.id}`;
      const isExternal = Boolean(item.data.externalUrl);
      return (
        <li class="news__item">
          <a
            class="news__link"
            href={href}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'noopener' : undefined}
          >
            {
              item.data.eyecatch && (
                <div class="news__thumb">
                  <Image
                    src={item.data.eyecatch}
                    alt={item.data.eyecatchAlt ?? ''}
                    width={240}
                    loading="lazy"
                  />
                </div>
              )
            }
            <div class="news__body">
              <p class="news__meta">
                <time class="news__date tabular" datetime={item.data.date.toISOString()}>
                  {formatDate(item.data.date)}
                </time>
                <span class="news__category">{NEWS_CATEGORY_LABEL[item.data.category]}</span>
              </p>
              <span class="news__title">
                {item.data.title}
                {isExternal && <span class="news__external" aria-label="外部サイトを開きます">↗</span>}
              </span>
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .news {
    border-top: 1px solid var(--color-border);
  }

  .news__item {
    border-bottom: 1px solid var(--color-border);
  }

  .news__link {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-5);
    text-decoration: none;
  }

  .news__link:hover .news__title {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* アイキャッチが無い記事も混ざるため、幅は固定してガタつかせない */
  .news__thumb {
    flex-shrink: 0;
    width: 96px;
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
  }

  .news__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news__body {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .news__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .news__date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .news__category {
    padding: 2px var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .news__title {
    font-weight: var(--weight-medium);
  }

  .news__external {
    margin-left: 0.4em;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .news__thumb {
      width: 160px;
    }

    .news__meta {
      gap: var(--space-4);
    }
  }
</style>
