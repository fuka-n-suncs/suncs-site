---
/** 「CS運用・改善」カテゴリのアイコン。回り続ける改善サイクル。 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M4.5 12a7.5 7.5 0 0 1 12.8-5.3"></path>
  <path d="M19.5 12a7.5 7.5 0 0 1-12.8 5.3"></path>
  <path d="M17.3 2.9v4.2h-4.2"></path>
  <path d="M6.7 21.1v-4.2h4.2"></path>
</svg>
