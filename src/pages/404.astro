---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="ページが見つかりません" noindex>
  <section class="section section--inverse">
    <div class="section__inner section__inner--center">
      <h1 class="section__title">ページが見つかりません</h1>
      <p class="section__lead">
        お探しのページは移動または削除された可能性があります。URLをご確認いただくか、トップページからお探しください。
      </p>
      <Button href="/">トップページへ戻る</Button>
    </div>
  </section>
</BaseLayout>
