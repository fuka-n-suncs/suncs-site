---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';

const sections = [
  {
    heading: '1. 基本方針',
    body: [
      '株式会社SUNCS（以下「当社」といいます）は、お客様の個人情報の重要性を認識し、個人情報の保護に関する法律その他の関係法令・ガイドラインを遵守し、以下のとおり個人情報保護方針を定め、適切な取得・利用・管理に努めます。',
    ],
  },
  {
    heading: '2. 取得する情報および取得方法',
    body: [
      '当社は、以下の場面において、お問い合わせフォーム等へのご入力により個人情報を取得します。',
    ],
    list: [
      'お問い合わせフォーム：会社名、お名前、メールアドレス、お問い合わせ内容',
      'CS戦闘力診断：診断への回答内容、および回答に付随してご入力いただいた情報',
      '資料ダウンロード等のフォーム：お名前、メールアドレス、会社名等、フォームごとにご案内する項目',
    ],
    after: [
      'また、Webサイトの利用状況を把握する目的で、Cookie等を通じてアクセス日時・閲覧ページ・端末情報等を自動的に取得する場合があります（詳細は「6. アクセス解析ツールについて」をご参照ください）。',
    ],
  },
  {
    heading: '3. 利用目的',
    body: ['取得した個人情報は、以下の目的の範囲内で利用します。'],
    list: [
      'お問い合わせ・ご相談への回答、サービスに関するご案内・ご提案のため',
      'CS戦闘力診断の結果の提供、および診断結果に基づく統計データの作成・公表（個人・企業を特定できない形に加工した上で利用します）',
      '資料のご送付、セミナー・取材等のご案内のため',
      'サービスの維持・改善、新サービスの検討のため',
      '上記利用目的に付随する目的のため',
    ],
  },
  {
    heading: '4. 第三者提供について',
    body: [
      '当社は、あらかじめお客様の同意を得た場合、または法令に基づき開示が求められた場合を除き、取得した個人情報を第三者に提供することはありません。',
    ],
  },
  {
    heading: '5. 個人情報の取扱いの委託について',
    body: [
      '当社は、利用目的の達成に必要な範囲において、個人情報の取扱いの全部または一部を外部の事業者に委託することがあります。委託先の選定にあたっては、個人情報を適切に取り扱っていると認められる事業者を選定し、必要な契約の締結等、適切な監督を行います。',
      '現時点で個人情報の取扱いに関連して利用している主な委託先・外部サービスは以下のとおりです。',
    ],
    list: [
      'Cloudflare, Inc.（Webサイトのホスティング、フォーム送信の受付・データ保管基盤）',
      'Resend（お問い合わせ受付時の通知メール配信）',
      'Google LLC（アクセス解析：Google Analytics、Google Search Console）',
      'Microsoft Corporation（アクセス解析：Microsoft Clarity）',
    ],
  },
  {
    heading: '6. アクセス解析ツールについて',
    body: [
      '当社Webサイトでは、サイトの利用状況を把握し、コンテンツの改善に役立てるため、Google Analytics、Google Search ConsoleおよびMicrosoft Clarityを利用しています。これらのツールはCookie等を使用してアクセス情報を収集しますが、氏名・メールアドレス等の個人を特定する情報は含まれません。収集された情報は各サービス提供者のプライバシーポリシーに基づき管理されます。',
      'Cookieの取得を希望されない場合は、ブラウザの設定によりCookieを無効にすることができます。ただし、その場合、Webサイトの一部機能がご利用いただけなくなることがあります。',
    ],
  },
  {
    heading: '7. 安全管理措置',
    body: [
      '当社は、取得した個人情報の紛失、破壊、改ざんおよび漏えい等を防止するため、合理的な安全対策を講じます。個人情報を取り扱う従業員の範囲を必要最小限に限定するとともに、外部からの不正アクセス等に対する技術的な対策を実施します。',
    ],
  },
  {
    heading: '8. 保有個人データの開示・訂正・利用停止等について',
    body: [
      'お客様ご本人から、当社が保有する個人情報について、開示・訂正・追加・削除・利用停止等のご請求があった場合には、ご本人であることを確認のうえ、法令に従い合理的な期間内に対応いたします。ご請求は下記お問い合わせ窓口までご連絡ください。',
    ],
  },
  {
    heading: '9. お問い合わせ窓口',
    body: [
      '個人情報の取扱いに関するお問い合わせは、下記までご連絡ください。',
    ],
    list: [
      '株式会社SUNCS',
      'オフィス：〒141-0033 東京都品川区西品川1-2-1',
      'メールアドレス：info@sun-cs.co.jp',
    ],
  },
  {
    heading: '10. プライバシーポリシーの変更について',
    body: [
      '当社は、法令の変更やサービス内容の変更等に伴い、本ポリシーの内容を予告なく変更することがあります。変更後のプライバシーポリシーは、本ページに掲載した時点から効力を生じるものとします。',
    ],
  },
];
---

<BaseLayout
  title="プライバシーポリシー"
  description="株式会社SUNCSのプライバシーポリシー（個人情報保護方針）。取得する情報の範囲、利用目的、第三者提供・委託の有無についてご案内します。"
>
  <PageHeader label="PRIVACY POLICY" title="プライバシーポリシー" compact />

  <Section>
    <div class="container container--narrow">
      <p class="lead">
        制定日：2026年9月11日
      </p>

      <div class="prose legal">
        {
          sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.body.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {section.list && (
                <ul>
                  {section.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              {section.after?.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </section>
          ))
        }
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .lead {
    margin-bottom: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: end;
  }

  .legal :global(h2) {
    font-size: var(--text-lg);
  }

  .legal :global(section + section) {
    margin-top: var(--space-10);
  }
</style>
