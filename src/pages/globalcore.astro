---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import keyVisual from '../assets/hero/globalcore.png';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import CaseCard from '../components/CaseCard.astro';

const cases = (await getCollection('cases', ({ data }) => !data.draft))
  .filter((entry) => entry.data.service === 'globalcore-outbound')
  .sort((a, b) => a.data.order - b.data.order);

const offerings = [
  {
    title: '進出可否を判断するための市場調査',
    body: 'デスクリサーチに加えて、実際に現地へ渡航します。市場規模と競合、法規制や制度面の一次調査まで踏み込みます。',
  },
  {
    title: '現地パートナー・KOL・投資家の開拓',
    body: '面談候補のリストアップからアポイントの打診、現地での面談実施、その後の関係構築までを担います。',
  },
  {
    title: '英語でのピッチ資料作成と商談同席',
    body: '日本語の提案をそのまま訳すのではなく、現地に伝わる構成に組み直します。商談には同席します。',
  },
  {
    title: '法規制・制度面の一次調査と論点整理',
    body: '進出前にクリアすべき課題を洗い出し、意思決定に必要な論点として整理します。',
  },
];
---

<BaseLayout
  title="GlobalCore"
  description="海外展開を検討する日本企業向けの支援。「展開する前提」ではなく「展開できる可能性があるか」の検証から入り、投資判断に必要な材料を揃えます。"
  image="/og/globalcore.jpg"
>
  <PageHeader
    title="GlobalCore"
    lead="海外展開は多くの企業にとって重要な成長戦略ですが、言語・文化・商習慣の違いが、進出後にこそ表面化します。SUNCSは市場調査から戦略設計、現地での新規開拓までを一貫して支援。カスタマーサクセスの知見を活かし、単なる進出支援に留まらず、現地で継続的に成果を生み出す仕組みづくりまで伴走します。"
    image={keyVisual}
    imagePosition="62% 38%"
  />

  <Section label="STANCE" title="やめる判断も、成果のうち">
    <div class="stance">
      <p class="stance__lead">
        海外展開の支援には、進出を前提に走り出すものが多くあります。
        しかし判断材料が揃っていない段階で必要なのは、推進力ではなく判断材料です。
      </p>
      <p class="stance__lead">
        SUNCSは、現地に行って一次情報を取り、投資判断ができる状態まで持っていくことを仕事だと考えています。
        調査の結果「いま出るべきではない」となることもあります。それも成果です。
      </p>
    </div>
  </Section>

  <Section label="SERVICE" title="提供範囲" tone="muted">
    <ul class="offerings" data-reveal-stagger>
      {
        offerings.map((offering) => (
          <li class="offering">
            <h3 class="offering__title">{offering.title}</h3>
            <p class="offering__body">{offering.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    cases.length > 0 && (
      <Section label="CASE" title="GlobalCore の事例">
        <ul class="cases" data-reveal-stagger>
          {cases.map((entry) => (
            <li>
              <CaseCard entry={entry} />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {/* インバウンド（海外企業の日本進出）への導線。日本語ページでは1ブロックだけ触れる */}
  <Section tone="muted">
    <aside class="inbound">
      <p class="inbound__label">For overseas companies</p>
      <h2 class="inbound__title">日本市場への参入を検討している海外企業の方へ</h2>
      <p class="inbound__body">
        SUNCSは、海外SaaS企業が日本で「売れる」「使われ続ける」状態をつくる支援も行っています。
        市場検証から日本CSデスクの運用、日本法人への移管までを担います。
      </p>
      <p class="inbound__note">
        ※英語版ページは準備中です。お問い合わせよりご連絡ください。
      </p>
      <Button href="/contact" variant="secondary">Contact us</Button>
    </aside>
  </Section>

  <Section tone="gradient" align="center">
    <h2 class="cta__title">まずは、現状の整理から</h2>
    <p class="cta__lead">
      検討している市場、今ある情報、決めきれていない論点をお聞かせください。
      調査設計のご提案から始めます。
    </p>
    <Button href="/contact" variant="primary" size="lg">相談する</Button>
  </Section>
</BaseLayout>

<style>
  .stance {
    display: grid;
    gap: var(--space-6);
    max-width: 46em;
  }

  .stance__lead {
    font-size: var(--text-lg);
  }

  .offerings,
  .cases {
    display: grid;
    gap: var(--space-6);
  }

  .offering {
    padding: var(--space-6);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
  }

  .offering__title {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-primary);
  }

  .offering__body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .inbound {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding: var(--space-8);
    background: var(--color-surface);
    border-radius: var(--radius-xl);
  }

  .inbound__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-primary);
  }

  .inbound__title {
    font-size: var(--text-2xl);
  }

  .inbound__body {
    max-width: 46em;
    color: var(--color-text-muted);
  }

  .inbound__note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .cta__title {
    font-size: var(--text-4xl);
  }

  .cta__lead {
    margin: var(--space-5) auto var(--space-10);
    max-width: 34em;
  }

  @media (min-width: 768px) {
    .offerings,
    .cases {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
