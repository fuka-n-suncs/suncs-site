---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsList from '../../components/NewsList.astro';
import keyVisual from '../../assets/hero/news.png';

const news = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="お知らせ"
  description="SUNCSからのプレスリリース、イベント・登壇、メディア掲載などのお知らせです。"
  image="/og/news.jpg"
>
  <PageHeader label="NEWS" title="お知らせ" image={keyVisual} imagePosition="50% 40%" compact />

  <div class="container section">
    {
      news.length === 0 ? (
        <p class="empty">現在お知らせはありません。</p>
      ) : (
        <NewsList items={news} />
      )
    }
  </div>
</BaseLayout>

<style>
  .empty {
    padding-block: var(--space-16);
    color: var(--color-text-muted);
  }
</style>
