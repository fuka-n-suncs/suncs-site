---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import keyVisual from '../assets/hero/company.png';
import { clientLogoFile } from '../consts';

const profile = [
  { label: '会社名', value: '株式会社SUNCS / SUNCS, inc.' },
  { label: '設立', value: '2023年12月27日' },
  { label: '代表取締役', value: '中村 風夏' },
  { label: '専務取締役', value: '松下 和誉' },
  { label: '所在地', value: '〒141-0033 東京都品川区西品川1-2-1 大崎ガーデンレジデンス' },
  { label: '事業内容', value: 'カスタマーサクセス支援／グローバル展開支援' },
  { label: '連絡先', value: 'info@sun-cs.co.jp ／ 070-8442-7245（平日 9:00〜19:00）' },
];

const values = [
  { en: 'Accept no limits', ja: '限界を決めない' },
  { en: 'Be a performer', ja: 'まずは自分が誰よりも体現すること' },
  { en: 'Choose spark over safety', ja: '正しさよりも、面白さを' },
];

const logos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/clients/*.{svg,png,webp,jpg,jpeg}',
  { eager: true }
);

/* macOSのファイル名はNFD、ソース中の文字列はNFCのため、正規化して引き当てる */
const byName = new Map(
  Object.entries(logos).map(([path, mod]) => [
    (path.split('/').pop() ?? '').normalize('NFC'),
    mod.default,
  ])
);

const group = [
  {
    name: 'CLF PARTNERS',
    body: '営業支援事業、新規ビジネス開発支援事業。グループの軸。',
    url: 'https://clfpartners.co.jp/',
    logo: byName.get(clientLogoFile('CLF PARTNERS')?.normalize('NFC') ?? ''),
  },
  {
    name: 'SUNCS',
    body: 'カスタマーサクセス支援事業、海外展開支援事業。',
    current: true,
    logoSrc: '/logo-horizontal.svg',
  },
  {
    name: 'HUMANFORCE',
    body: '人材事業、店舗ビジネス支援事業。',
    url: 'https://humanforce.co.jp/',
    logo: byName.get(clientLogoFile('HUMANFORCE')?.normalize('NFC') ?? ''),
  },
];
---

<BaseLayout
  title="会社概要"
  description="株式会社SUNCSの会社概要。カスタマーサクセス支援とグローバル展開支援を手がけ、CLF PARTNERSグループの一員として事業を展開しています。"
  image="/og/company.jpg"
>
  <PageHeader
    label="COMPANY"
    title="会社概要"
    image={keyVisual}
    imagePosition="50% 48%"
    compact
  />

  <Section label="MISSION" title="顧客の成長と笑顔を生み出す太陽になる">
    <div class="philosophy">
      <div class="philosophy__block">
        <h3 class="philosophy__heading">VISION</h3>
        <p class="philosophy__text">人×AIで最高のおもてなしを実現する</p>
      </div>

      <div class="philosophy__block">
        <h3 class="philosophy__heading">VALUE</h3>
        <ul class="values" data-reveal-stagger>
          {
            values.map((value) => (
              <li class="value">
                <span class="value__en">{value.en}</span>
                <span class="value__ja">{value.ja}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Section label="PROFILE" title="会社情報" tone="muted">
    <dl class="profile">
      {
        profile.map((row) => (
          <div class="profile__row">
            <dt class="profile__label">{row.label}</dt>
            <dd class="profile__value">{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section
    label="GROUP"
    title="CLF PARTNERSグループ"
    lead="グループ共通の課題認識は「人・仕組み・システムがバラバラで機能しない」こと。SUNCSはそのうち「売上と関係が、つながらない」——受注後の関係を育てる設計がない、という領域を担っています。"
  >
    <ul class="group" data-reveal-stagger>
      {
        group.map((company) => (
          <li class:list={['group__item', company.current && 'group__item--current']}>
            <div class="group__logo">
              {company.logo ? (
                <Image src={company.logo} alt={company.name} width={240} densities={[1, 2]} />
              ) : company.logoSrc ? (
                <img src={company.logoSrc} alt={company.name} width="177" height="50" />
              ) : (
                <span class="group__name-fallback">{company.name}</span>
              )}
            </div>
            <h3 class="group__name">{company.name}</h3>
            <p class="group__body">{company.body}</p>
            {company.url && (
              <a class="group__link" href={company.url} target="_blank" rel="noopener">
                公式サイト<span aria-hidden="true"> ↗</span>
                <span class="visually-hidden">（外部サイトを開きます）</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="gradient" align="center">
    <h2 class="cta__title">お問い合わせ</h2>
    <p class="cta__lead">
      サービスのご相談、取材・登壇のご依頼などはこちらからご連絡ください。
    </p>
    <Button href="/contact" variant="primary" size="lg">お問い合わせ</Button>
  </Section>
</BaseLayout>

<style>
  .philosophy {
    display: grid;
    gap: var(--space-12);
  }

  .philosophy__heading {
    margin-bottom: var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-primary);
  }

  .philosophy__text {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }

  .values {
    display: grid;
    gap: var(--space-4);
  }

  .value {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5);
    background: var(--color-surface-muted);
    border-radius: var(--radius-md);
  }

  .value__en {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
  }

  .value__ja {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .profile {
    display: grid;
  }

  .profile__row {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .profile__row:first-child {
    border-top: 1px solid var(--color-border);
  }

  .profile__label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .group {
    display: grid;
    gap: var(--space-4);
  }

  .group__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .group__item--current {
    background: var(--color-primary-subtle);
    border-color: transparent;
  }

  .group__logo {
    display: grid;
    place-items: center;
    height: 64px;
    margin-bottom: var(--space-2);
    padding: var(--space-2);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }

  .group__logo img {
    width: auto;
    max-width: 100%;
    max-height: 44px;
    object-fit: contain;
  }

  .group__name-fallback {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .group__name {
    font-size: var(--text-lg);
  }

  .group__link {
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .group__link:hover {
    text-decoration: underline;
  }

  .group__item--current .group__name {
    color: var(--color-primary);
  }

  .group__body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .cta__title {
    font-size: var(--text-4xl);
  }

  .cta__lead {
    margin: var(--space-5) auto var(--space-10);
    max-width: 34em;
  }

  @media (min-width: 768px) {
    .values,
    .group {
      grid-template-columns: repeat(3, 1fr);
    }

    .profile__row {
      grid-template-columns: 14em 1fr;
      gap: var(--space-6);
    }
  }
</style>
